# Stellar Chain Indexer - Rust Service Configuration

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/stellar_indexer

# Stellar Horizon API
HORIZON_URL=https://horizon.stellar.org

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379

# Indexer Configuration
INDEXER_START_LEDGER=1
INDEXER_BATCH_SIZE=100

# Features
ENABLE_METRICS=true

# Logging
RUST_LOG=stellar_chain_indexer=info,actix_web=info
