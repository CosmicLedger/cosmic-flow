# Stellar Chain Explorer - Environment Variables Template
# Copy this file to .env and fill in the values

# ============================================
# Application Environment
# ============================================
NODE_ENV=development

# ============================================
# Stellar Horizon API Endpoints
# ============================================
# Public Network (Mainnet)
HORIZON_PUBLIC=https://horizon.stellar.org

# Testnet
HORIZON_TEST=https://horizon-testnet.stellar.org

# Futurenet
HORIZON_FUTURE=https://horizon-futurenet.stellar.org

# Local Development (if running local Stellar network)
HORIZON_LOCAL=http://localhost:8000

# ============================================
# Sentry Error Tracking (Optional)
# ============================================
# Get your DSN from https://sentry.io/
SENTRY_DSN=

# Sentry Environment
SENTRY_ENVIRONMENT=development

# Sentry Release Version
SENTRY_RELEASE=

# Sentry Traces Sample Rate (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# Analytics (Optional)
# ============================================
# Google Analytics ID
GOOGLE_ANALYTICS_ID=

# Plausible Analytics Domain
PLAUSIBLE_DOMAIN=

# ============================================
# Cloudflare Pages (Deployment)
# ============================================
# Get from Cloudflare Dashboard
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PROJECT_NAME=stellar-chain-explorer

# ============================================
# Fly.io (API Deployment)
# ============================================
FLY_API_TOKEN=
FLY_APP_NAME=cosmicledger-api

# ============================================
# Feature Flags
# ============================================
# Enable/disable features
ENABLE_ANALYTICS=false
ENABLE_ERROR_TRACKING=false
ENABLE_BETA_FEATURES=false

# ============================================
# API Configuration
# ============================================
# API Base URL (if using separate API)
API_BASE_URL=https://api.cosmicledger.io

# API Timeout (milliseconds)
API_TIMEOUT=30000

# API Rate Limit (requests per minute)
API_RATE_LIMIT=60

# ============================================
# Development Tools
# ============================================
# Enable React DevTools
ENABLE_REACT_DEVTOOLS=true

# Enable verbose logging
DEBUG=false
LOG_LEVEL=info

# ============================================
# Security
# ============================================
# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# ============================================
# Database (if applicable)
# ============================================
# DATABASE_URL=postgresql://user:password@localhost:5432/stellar_explorer
# REDIS_URL=redis://localhost:6379

# ============================================
# Email (if applicable)
# ============================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@cosmicledger.io

# ============================================
# Cache Configuration
# ============================================
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
